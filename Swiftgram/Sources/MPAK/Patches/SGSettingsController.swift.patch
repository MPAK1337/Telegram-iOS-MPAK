# Step 6: Add action handler for "Delete All" button
# Find where other actions are handled and add:

            // Handle MPAK Delete All action
            if entry.section == .mpakFilters && entry.kind == .destructive {
                let presentationData = context.sharedContext.currentPresentationData.with { $0 }
                let lang = presentationData.strings.baseLanguageCode
                
                let alertController = textAlertController(
                    context: context,
                    title: i18n("MPAK.DeleteAll.Confirm.Title", lang),
                    text: i18n("MPAK.DeleteAll.Confirm.Text", lang),
                    actions: [
                        TextAlertAction(type: .destructiveAction, title: i18n("MPAK.DeleteAll.Confirm.Delete", lang), action: {
                            MPAKDeletedMessages.clearAllMPAKData()
                        }),
                        TextAlertAction(type: .defaultAction, title: presentationData.strings.Common_Cancel, action: {})
                    ]
                )
                presentControllerImpl?(alertController, nil)
            }
